datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MediaType {
  IMAGE
  VIDEO
}

model Collection {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  slug        String?     @unique
  media       MediaItem[] // Contains both images and videos

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model MediaItem {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  type             MediaType   @default(IMAGE)
  url              String
  publicId         String?
  altText          String?
  caption          String?
  duration         Float?      // Optional: Video duration in seconds
  thumbnailUrl     String?     // Optional: Poster image for videos
  size             Int?
  width            Int?
  height           Int?
  mimeType         String?
  order            Int?        @default(0) // Custom arrangement index inside a collection
  collectionId     String?     @db.ObjectId
  collection       Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  // Optional (not required-with-default) so existing MongoDB documents that
  // predate this field read back safely as `null`/`undefined` instead of
  // failing validation. Treat as `false` in application code when absent.
  isMemory         Boolean?
  // Only set when isMemory transitions false -> true. Used to order the
  // Memories selection stably, without reshuffling on unrelated edits
  // (e.g. editing a caption shouldn't change Memories order).
  memorySelectedAt DateTime?

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}